// Crochê com Raquel — catálogo institucional.
// NÃO é loja: não existe carrinho, pagamento, estoque nem pedido.
// A conversão acontece por WhatsApp, com a mensagem montada a partir das
// opções que o cliente escolhe na página do produto.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  PUBLISHED
}

/// Como o cliente escolhe o valor da opção na página do produto.
enum OptionType {
  /// Uma opção entre várias — cor, tamanho, tipo de alça.
  SINGLE
  /// Várias ao mesmo tempo — ex.: adicionais.
  MULTIPLE
  /// Texto livre digitado pelo cliente — monograma, nome bordado.
  TEXT
}

// ---------------------------------------------------------------- acesso

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ------------------------------------------------------------ taxonomia

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  /// Uma linha, usada no card e abaixo do título.
  description String?
  /// Texto longo da página da categoria — é o conteúdo indexável que faz a
  /// página ranquear (o hub de bolsas mira "bolsa de crochê"). Fica no banco
  /// e não no código para a Raquel poder editar no admin. Markdown simples:
  /// parágrafos separados por linha em branco, `## ` vira subtítulo.
  longDescription String?
  position    Int     @default(0)

  subcategories Subcategory[]
  products      Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Só as bolsas usam subcategoria (transversal, tote, clutch, praia,
/// mochila, ecobag, necessaire). As outras categorias ficam planas.
model Subcategory {
  id         String @id @default(cuid())
  slug       String
  name       String
  position   Int    @default(0)
  categoryId String

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, slug])
}

/// Coleções sazonais (Natal, Dia das Mães). Atravessam as categorias e a
/// Raquel liga e desliga no admin — por isso `active`.
model Collection {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  active      Boolean @default(true)
  position    Int     @default(0)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -------------------------------------------------------------- produto

model Product {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String

  /// Preço é OPCIONAL de propósito: nulo significa "sob consulta", porque
  /// boa parte das peças é orçada caso a caso. Toda UI que exibe preço
  /// precisa tratar o nulo.
  price Decimal? @db.Decimal(10, 2)

  /// Medidas reais em cm, como texto — "30 × 25 × 12 cm".
  dimensions String?
  /// Fio e materiais usados.
  material String?
  /// Capacidade em linguagem de gente: "cabe carteira, celular e chaves".
  /// Reduz muito a pergunta no WhatsApp. Sobretudo em bolsas.
  capacity String?
  /// Cuidados com a peça (lavagem, secagem).
  careText String?

  /// Prazo de produção em dias, como faixa: "pronta em 7 a 10 dias".
  productionDaysMin Int?
  productionDaysMax Int?

  status           ProductStatus @default(DRAFT)
  /// Curadoria da home. `featuredPosition` ordena a vitrine de destaques.
  featured         Boolean       @default(false)
  featuredPosition Int?
  /// Ordem dentro da categoria.
  position         Int           @default(0)

  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])

  collections  Collection[]
  images       ProductImage[]
  optionGroups ProductOptionGroup[]
  testimonials Testimonial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, featured, featuredPosition])
  @@index([categoryId, position])
  @@index([subcategoryId])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  /// URL no Vercel Blob.
  url       String
  alt       String
  position  Int    @default(0)

  /// Foto com escala humana (peça sendo usada por uma pessoa). A direção de
  /// arte da identidade exige pelo menos uma em toda bolsa — o admin usa
  /// esta marca para avisar quando falta.
  hasHumanScale Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

// -------------------------------------------------------------- opções
//
// Cor e tamanho NÃO são campos do produto: tamanho só se aplica a algumas
// peças, e bolsa ainda tem alça, forro e fecho. O vocabulário é global
// (a Raquel cadastra "Terracota" uma vez) e cada produto escolhe quais
// grupos usa e quais valores daquele grupo estão disponíveis nele.

/// Grupo global de opções: "Cor", "Tamanho", "Alça", "Forro", "Fecho",
/// "Personalização".
model OptionGroup {
  id       String     @id @default(cuid())
  slug     String     @unique
  name     String
  type     OptionType @default(SINGLE)
  position Int        @default(0)
  /// Desligar esconde o grupo inteiro do site sem apagar nada.
  active   Boolean    @default(true)

  values   OptionValue[]
  products ProductOptionGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Valor global dentro de um grupo: "Terracota" (com hex), "P", "Transversal".
model OptionValue {
  id       String  @id @default(cuid())
  groupId  String
  slug     String
  name     String
  /// Cor em #RRGGBB, só para o grupo de cor — é o que desenha a bolinha no
  /// seletor. No admin a Raquel escolhe pela roda de cores ou cola o código.
  /// ATENÇÃO: serve para a tela, NÃO para recomprar o fio — a mesma
  /// "terracota" muda de tom entre linhas. Quem serve para comprar são os
  /// dois campos abaixo.
  hex      String?

  /// Linha do fio como vem na etiqueta: "Barroco Maxcolor 400g".
  yarnLine      String?
  /// Código da cor no fabricante: "7684". É por ele que a Raquel recompra e
  /// garante que a peça nova sai igual à da foto. Opcional, porque nem todo
  /// fio que ela usa tem etiqueta.
  yarnColorCode String?

  position Int     @default(0)
  /// Desligar tira o valor do site sem apagá-lo. É o que a Raquel usa quando
  /// acaba um fio: a cor some das páginas, mas continua ligada aos produtos
  /// que já a usavam e volta inteira quando ela religar. Apagar, não —
  /// apagar removeria a cor de todos os produtos de uma vez.
  active   Boolean @default(true)

  group    OptionGroup          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  products ProductOptionValue[]

  @@unique([groupId, slug])
  @@index([groupId, position])
}

/// Quais grupos de opção este produto usa, e se responder é obrigatório.
model ProductOptionGroup {
  id        String  @id @default(cuid())
  productId String
  groupId   String
  required  Boolean @default(false)
  position  Int     @default(0)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  group   OptionGroup          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, groupId])
}

/// Quais valores daquele grupo estão disponíveis neste produto — nem toda
/// bolsa sai em todas as cores.
model ProductOptionValue {
  id                   String @id @default(cuid())
  productOptionGroupId String
  optionValueId        String
  position             Int    @default(0)

  productOptionGroup ProductOptionGroup @relation(fields: [productOptionGroupId], references: [id], onDelete: Cascade)
  optionValue        OptionValue        @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@unique([productOptionGroupId, optionValueId])
}

// -------------------------------------------------------------- conteúdo

model Testimonial {
  id         String  @id @default(cuid())
  authorName String
  text       String
  city       String?
  /// Print do WhatsApp ou foto da peça na casa do cliente, no Blob.
  imageUrl   String?
  productId  String?
  published  Boolean @default(false)
  position   Int     @default(0)

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, position])
}

/// Linha única de configuração do site, editável no admin.
model SiteSettings {
  id String @id @default("singleton")

  /// Só dígitos, com país e DDD: 5524999999999.
  whatsappNumber String
  /// Template da mensagem, com marcadores substituídos na página do produto:
  /// {produto} {codigo} {opcoes} {quantidade} {link}
  whatsappTemplate String

  instagramUrl String?
  email        String?
  city         String  @default("Petrópolis, RJ")

  heroTitle    String?
  heroSubtitle String?
  aboutText    String?

  /// Faixa de aviso no topo ("Encomendas de Natal até 30/11").
  announcementText   String?
  announcementActive Boolean @default(false)

  updatedAt DateTime @updatedAt
}
