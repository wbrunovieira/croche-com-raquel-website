# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/src/generated

# Saída padrão do `scripts/backup.ts` — 23 MB de fotos das peças dela. O backup
# de verdade mora em outro repositório (croche-com-raquel-backups, privado);
# aqui ele só aparece quando alguém roda o script sem `--destino`, e um
# `git add -A` distraído mandaria o acervo inteiro para dentro do código.
backup/
